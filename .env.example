# ---- LLM (Meta Model API, OpenAI-compatible) ----
LLM_BASE_URL=https://api.meta.ai/v1
LLM_MODEL=muse-spark-1.3
MODEL_API_KEY=            # primary teammate key
MODEL_API_KEY_BACKUP=     # second teammate key, used on 429 / credit exhaustion
LLM_REASONING_EFFORT=low  # live translation; eval/extraction may use medium

# ---- ASR ----
ASR_PROVIDER=muse         # muse | deepgram | mock
DEEPGRAM_API_KEY=
ASR_HERITAGE_LANG=ta      # Deepgram monolingual code for the grandparent side
ASR_SAMPLE_RATE=16000

# ---- TTS ----
TTS_PROVIDER=elevenlabs   # elevenlabs | mock
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_LIVE=eleven_flash_v2_5
ELEVENLABS_MODEL_GLOSSARY=eleven_multilingual_v2
ELEVENLABS_DEFAULT_VOICE_ID=   # stock multilingual voice id from GET /v1/voices (premade voices work with flash v2.5 in Tamil); required, else TTS 4xx

# ---- Transport ----
TRANSPORT=websocket       # websocket | livekit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Phone bridge (Phase 5) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
PUBLIC_WSS_HOST=          # e.g. abc123.ngrok.app (no scheme); ngrok http 8000
TWILIO_HERITAGE_LANG=ta-IN # VERIFY in ConversationRelay voice configuration

# ---- Data ----
DATABASE_URL=sqlite:///./kin.db
EMBEDDINGS_PROVIDER=none  # none | openai_compatible | local
KIN_API_KEY=change-me     # read-only key for the Muse connector endpoints
DEMO_FAMILY_ID=1
